<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Palette : fond très sombre, accent indigo-violet, textes à fort contraste (lisibles par un proche malvoyant). -->
    <color name="bg">#0B0D12</color>
    <color name="bg_top">#141827</color>
    <color name="surface">#161A24</color>
    <color name="surface_high">#1F2433</color>
    <color name="outline">#2A3042</color>
    <color name="text">#F3F4F8</color>
    <color name="text_muted">#A3AAB9</color>
    <color name="accent">#7C83FF</color>
    <color name="accent_2">#A66BFF</color>
    <color name="on">#3DDC97</color>
    <color name="off">#FF6B6B</color>
    <color name="disabled">#2A2F3D</color>

    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_screen</item>
        <item name="android:statusBarColor">@color/bg_top</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorControlActivated">@color/accent</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_muted</item>
        <item name="android:textColorHint">@color/text_muted</item>
        <item name="android:editTextStyle">@style/Field</item>
        <item name="android:buttonStyle">@style/SecondaryButton</item>
    </style>

    <style name="Field" parent="@android:style/Widget.DeviceDefault.EditText">
        <item name="android:background">@drawable/field</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:minHeight">56dp</item>
    </style>

    <style name="SecondaryButton" parent="@android:style/Widget.DeviceDefault.Button">
        <item name="android:background">@drawable/button_secondary</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>
